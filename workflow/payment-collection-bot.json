      "id": "e30a7901-e7c8-45d9-905d-814e2864eafd",
      "name": "Read Round Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        3776,
        320
      ],
      "alwaysOutputData": true,
      "credentials": {
