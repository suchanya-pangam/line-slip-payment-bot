        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Make sure the matched student has a row in the chosen round sheet and is not already marked paid.\nconst ID_COL = 'รหัสนักศึกษา';\nconst STATUS_COL = 'สถานะ';\nconst PAID = 'ชำระแล้ว';\nconst DUE_COL = 'ยอดที่ต้องจ่าย (บาท)';\nconst toNum = function (v) { const s = String(v == null ? '' : v).replace(/[^0-9.]/g, ''); return s === '' ? null : Number(s); };\nconst rows = $input.all().map(function (i) { return i.json; }).filter(function (r) { return Object.keys(r).length > 0; });\nconst sheetMissing = rows.some(function (r) { return r.error; }) && !rows.some(function (r) { return r[ID_COL] != null; });\nreturn $('Choose Payment Round').all().map(function (i) {\n  const r = i.json;\n  const row = rows.find(function (x) { return String(x[ID_COL] == null ? '' : x[ID_COL]).trim() === String(r.studentId).trim(); });\n  let status = 'ready';\n  let reason = '';\n  if (!r.roundSheet) { status = 'round_not_found'; reason = 'Could not read a transfer date from the slip, so no payment round could be selected'; }\n  else if (sheetMissing) { status = 'round_not_found'; reason = 'No payment round sheet named ' + r.roundSheet + ' (from the slip transfer date)'; }\n  else if (!row) { status = 'not_in_round'; reason = 'Student ' + r.studentId + ' not found in round sheet ' + r.roundSheet; }\n  else if (String(row[STATUS_COL] || '').trim() === PAID) { status = 'already_paid'; reason = 'Student already marked paid in round ' + r.roundSheet; }\n  else {\n    // Only auto-confirm when the slip amount equals the amount due for this student in this round\n    const due = toNum(row[DUE_COL]);\n    const paid = toNum(r.amount);\n    if (due === null) { status = 'amount_mismatch'; reason = 'Amount mismatch: ' + DUE_COL + ' is blank for student ' + r.studentId + ' in round ' + r.roundSheet + '; slip amount ' + paid; }\n    else if (paid === null || Math.abs(paid - due) > 0.005) { status = 'amount_mismatch'; reason = 'Amount mismatch: slip amount ' + paid + ' does not equal amount due ' + due + ' in round ' + r.roundSheet; }\n  }\n  return { json: Object.assign({}, r, { status: status, reviewReason: reason }) };\n});"
      },
