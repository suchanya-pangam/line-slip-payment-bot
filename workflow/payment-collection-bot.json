      "parameters": {
        "jsCode": "// Compare each downloaded slip's SHA-256 with every hash already logged in _ประวัติรายการ\nconst history = $input.all().map(function (i) { return i.json; });\nconst seen = new Set(history.map(function (r) { return String(r.image_sha256 || '').trim().toLowerCase(); }).filter(Boolean));\n// The file download replaces item JSON, so read the LINE event back from the image-check node by position\nconst events = $('Is Image Message?').all();\n// The hash node does not pass the image file through, so take the file from the download node by position\nconst files = $('Download Slip Image').all();\nreturn $('Compute Image SHA-256').all().map(function (item, idx) {\n  const e = events[idx] ? events[idx].json : {};\n  const hash = String(item.json.imageSha256 || '').toLowerCase();\n  return {\n    json: {\n      status: seen.has(hash) ? 'duplicate_image' : 'new',\n      replyToken: e.replyToken,\n      webhookEventId: e.webhookEventId,\n      messageId: e.message ? e.message.id : '',\n      lineUserId: e.source ? e.source.userId : '',\n      imageSha256: hash,\n    },\n    binary: files[idx] && files[idx].binary ? files[idx].binary : item.binary,\n  };\n});"
      },
