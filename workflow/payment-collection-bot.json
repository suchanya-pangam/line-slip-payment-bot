    {
      "parameters": {
        "jsCode": "// Match the slip payer name against the รายชื่อ sheet. Only a single confident match is accepted.\nconst roster = $input.all().map(function (i) { return i.json; }).filter(function (r) { return Object.keys(r).length > 0; });\nconst slips = $('Parse Slip Data').all().map(function (i) { return i.json; }).filter(function (j) { return j.status === 'ok'; });\n\nconst keys = roster.length ? Object.keys(roster[0]) : [];\nconst idKey = keys.find(function (k) { return /รหัส|รหัศ|student.?id|^id$/i.test(k); });\nconst engKey = keys.find(function (k) { return /eng|อังกฤษ|name_en/i.test(k); });\nconst surnameKey = keys.find(function (k) { return /^(นามสกุล|surname|last.?name)$/i.test(k.trim()); });\nconst nameKey = keys.find(function (k) { return /ชื่อ|name/i.test(k) && k !== engKey && k !== surnameKey; });\n\nconst TITLE = /^(นางสาว|นาง|นาย|น\\.ส\\.?|นส\\.?|ด\\.ช\\.?|ด\\.ญ\\.?|mrs\\.?|mr\\.?|ms\\.?|miss)\\s*/i;\nfunction norm(s) {\n  return String(s || '').toLowerCase().replace(/[.,()]/g, ' ').replace(/[*＊•·●○]+$/g, '').replace(/\\s+/g, ' ').trim();\n}\nfunction parts(s) {\n  let n = norm(s);\n  n = n.replace(TITLE, '').trim();\n  const p = n.split(' ').filter(Boolean);\n  return { first: p[0] || '', last: p.slice(1).join(''), full: p.join('') };\n}\n\nconst students = roster.map(function (r) {\n  const th = surnameKey && nameKey ? String(r[nameKey] || '') + ' ' + String(r[surnameKey] || '') : String(r[nameKey] || '');\n  return { id: String(r[idKey] || '').trim(), name: th.trim(), names: [parts(th)].concat(engKey ? [parts(r[engKey])] : []) };\n}).filter(function (s) { return s.id && s.name; });\n\nreturn slips.map(function (slip) {\n  const p = parts(slip.payerName);\n  const exact = [];\n  const partial = [];\n  for (const s of students) {\n    let lvl = 0;\n    for (const n of s.names) {\n      if (!n.first) continue;\n      if (p.full && n.full === p.full) lvl = Math.max(lvl, 2);\n      else if (p.first === n.first && p.last && n.last.indexOf(p.last) === 0) lvl = Math.max(lvl, 1);\n    }\n    if (lvl === 2) exact.push(s);\n    else if (lvl === 1) partial.push(s);\n  }\n  let match = null;\n  let method = '';\n  if (exact.length === 1) { match = exact[0]; method = 'exact_name'; }\n  else if (exact.length === 0 && partial.length === 1) { match = partial[0]; method = 'first_name_and_surname_prefix'; }\n  const candidates = exact.concat(partial).map(function (s) { return s.id + ' ' + s.name; }).join(', ');\n  return {\n    json: Object.assign({}, slip, {\n      status: match ? 'matched' : 'no_match',\n      studentId: match ? match.id : '',\n      studentName: match ? match.name : '',\n      matchMethod: method,\n      reviewReason: match ? '' : (candidates ? 'Multiple possible students: ' + candidates : 'No student name matched the payer name'),\n      candidates: candidates,\n    }),\n  };\n});"
      },
