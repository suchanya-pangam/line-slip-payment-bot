      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Round sheets are named dd/mm/yy (Gregorian, 2-digit year). Build the sheet name from the slip's transfer date,\n// e.g. a transfer on 2025-03-03 -> sheet \"03/03/25\". If that sheet does not exist, the slip goes to manual review.\nconst m = $json;\nconst zone = 'Asia/Bangkok';\nlet txn = m.transactionDateTime ? DateTime.fromISO(String(m.transactionDateTime), { zone: zone }) : null;\nif (txn && txn.isValid && txn.year > 2400) txn = txn.minus({ years: 543 });\nconst valid = !!(txn && txn.isValid);\nreturn {\n  json: Object.assign({}, m, {\n    roundSheet: valid ? txn.toFormat('dd/MM/yy') : '',\n    paidAt: valid ? txn.toFormat('yyyy-MM-dd HH:mm:ss') : '',\n  }),\n};"
      },
      "id": "802d8aaa-7280-4871-b1a0-e30806e20287",
      "name": "Choose Payment Round",
      "type": "n8n-nodes-base.code",
