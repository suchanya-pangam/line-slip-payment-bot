    {
      "parameters": {
        "resource": "image",
        "operation": "analyze",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "GPT-5-MINI"
        },
        "text": "You read Thai bank transfer slips (e.g. K PLUS, SCB EASY, Krungthai NEXT, Bangkok Bank, Krungsri, ttb, GSB, PromptPay). Look at the image and reply with ONLY a JSON object, no markdown, using exactly these keys: {\"is_slip\": boolean (true only if this is a bank transfer slip/receipt), \"payer_name\": string (sender / from name exactly as printed, keep Thai script and title), \"receiver_name\": string, \"amount\": number (transferred amount in THB, no commas, no currency), \"reference_no\": string (transaction / reference number, e.g. เลขที่รายการ or รหัสอ้างอิง, copy exactly), \"transaction_datetime\": string (ISO 8601 like 2025-07-18T14:05:00+07:00; convert Buddhist year to Gregorian: 2568 or 68 means 2025; Thai month abbreviations ม.ค.=01 ... ธ.ค.=12), \"bank\": string, \"confidence\": number between 0 and 1}. Use an empty string or null for any value you cannot read. Never guess numbers.",
        "inputType": "base64",
        "simplify": false,
        "options": {
          "detail": "high",
          "maxTokens": 4000
        }
      },
      "id": "b094a67f-36d8-4416-9153-5ad1109cbf7f",
      "name": "Read Bank Slip (AI OCR)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        1856,
        480
