    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Compose LINE reply using only the data that reaches this node.\n// Do not reference nodes from another branch.\n\nconst data = $json;\nlet status = data.status;\n\n// If no status exists, identify the simple cases from the current input.\nif (!status) {\n  if (\n    data.message &&\n    data.message.type &&\n    data.message.type !== 'image'\n  ) {\n    status = 'not_image';\n  } else {\n    // A payment confirmation requires explicit success from the recording path.\n    status = 'needs_review';\n  }\n}\n\nconst NL = '\\n';\n\nconst review =\n  'ได้รับสลิปแล้ว แต่ระบบยังไม่สามารถยืนยันรายการได้โดยอัตโนมัติ ' +\n  'ผู้ดูแลจะตรวจสอบและบันทึกให้ภายหลัง';\n\nconst texts = {\n  not_image:\n    'กรุณาส่งรูปภาพสลิปการโอนเงิน เพื่อบันทึกการชำระเงินค่าภาควิชา',\n\n  duplicate_image:\n    'สลิปนี้เคยถูกส่งและบันทึกไปแล้ว ระบบจะไม่บันทึกซ้ำ ' +\n    'หากมีข้อสงสัยกรุณาติดต่อผู้ดูแล',\n\n  duplicate_ref:\n    'เลขที่รายการของสลิปนี้เคยถูกบันทึกไปแล้ว ระบบจะไม่บันทึกซ้ำ ' +\n    'หากมีข้อสงสัยกรุณาติดต่อผู้ดูแล',\n\n  unreadable:\n    'ไม่สามารถอ่านข้อมูลจากสลิปได้ กรุณาส่งรูปสลิปที่ชัดเจนและครบถ้วนอีกครั้ง',\n\n  no_match: review,\n\n  not_in_round: review,\n\n  round_not_found: review,\n\n  amount_mismatch:\n    'ได้รับสลิปแล้ว แต่ยอดเงินในสลิป (' +\n    (data.amount == null ? '-' : data.amount) +\n    ' บาท) ไม่ตรงกับยอดที่ต้องชำระในรอบ ' +\n    (data.roundSheet || '') +\n    ' รายการนี้ต้องให้ผู้ดูแลตรวจสอบ ระบบยังไม่ได้บันทึกว่าชำระแล้ว',\n\n  already_paid:\n    'ระบบพบว่าคุณถูกบันทึกว่าชำระแล้วในรอบ ' +\n    (data.roundSheet || '') +\n    ' ผู้ดูแลจะตรวจสอบสลิปนี้เพิ่มเติม',\n\n  paid: [\n    'บันทึกการชำระเงินค่าภาควิชาเรียบร้อยแล้ว',\n    'ชื่อ: ' + (data.studentName || ''),\n    'รหัสนักศึกษา: ' + (data.studentId || ''),\n    'ยอดเงิน: ' + (data.amount ?? '') + ' บาท',\n    'รอบเก็บเงิน: ' + (data.roundSheet || ''),\n    'เลขที่รายการ: ' + (data.referenceNo || ''),\n  ].join(NL),\n};\n\nreturn {\n  json: {\n    ...data,\n    status,\n    replyToken: data.replyToken,\n    replyText: texts[status] || review,\n  },\n};"
      },
