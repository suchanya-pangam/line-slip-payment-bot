    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\nconst context = $('Check Duplicate Image').item.json;\nconst message = Array.isArray(j.output) ? j.output.find(x => x && x.type === 'message') : null;\nconst content = message && Array.isArray(message.content) ? message.content.find(x => x && x.type === 'output_text') : null;\nlet raw = content?.text || '';\nif (typeof raw !== 'string') raw = JSON.stringify(raw);\nraw = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\nlet parsed;\ntry { parsed = JSON.parse(raw); } catch (error) {\n  return { json: { ...context, status: 'unreadable', is_slip: false, readable: false, parse_error: true, raw_ai_output: raw } };\n}\nconst amount = parsed.amount != null ? Number(parsed.amount) : null;\nconst readable = parsed.is_slip === true && Number.isFinite(amount) && amount > 0 && !!parsed.payer_name && !!parsed.reference_no && !!parsed.transaction_datetime;\nreturn { json: {\n  ...context,\n  status: readable ? 'ok' : 'unreadable',\n  is_slip: parsed.is_slip === true, readable,\n  payer_name: parsed.payer_name || null,\n  receiver_name: parsed.receiver_name || null, amount,\n  reference_no: parsed.reference_no || null,\n  transaction_datetime: parsed.transaction_datetime || null,\n  payerName: parsed.payer_name || '',\n  receiverName: parsed.receiver_name || '',\n  referenceNo: parsed.reference_no || '',\n  transactionDateTime: parsed.transaction_datetime || '',\n  bank: parsed.bank || null,\n  confidence: parsed.confidence != null ? Number(parsed.confidence) : null\n} };"
      },
